# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Security / Authentication
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (Neon Cloud Production or Direct URL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
NEON_FETCH_ENDPOINT=

# Neon Local Proxy Configuration (Development only)
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
PARENT_BRANCH_ID=
DELETE_BRANCH=true

# Arcjet
ARCJET_KEY=your_arcjet_key_here
