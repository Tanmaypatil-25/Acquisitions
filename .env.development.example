# Application Config
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Security / Authentication
JWT_SECRET=development-secret-key-change-in-production

# Neon Local Docker Proxy Configuration
# Get your API key and Project ID from your Neon Console (https://console.neon.tech)
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
# Optional: specify parent branch ID to fork from (leave blank to fork from main/default)
PARENT_BRANCH_ID=
# Automatically cleanup ephemeral branch when container stops
DELETE_BRANCH=true

# Database Connection (when running app inside Docker Compose pointing to neon-local)
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb?sslmode=no-verify
NEON_FETCH_ENDPOINT=http://neon-local:5432/sql

# Database Connection (if running host scripts/drizzle-kit from outside Docker)
# DATABASE_URL=postgres://neon:npg@localhost:5432/neondb?sslmode=no-verify
# NEON_FETCH_ENDPOINT=http://localhost:5432/sql

# Arcjet Development Key
ARCJET_KEY=your_arcjet_development_key_here

