# Application Config
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Security / Authentication (CRITICAL: Use a strong, random 64-char key in production)
JWT_SECRET=your_production_jwt_secret_key_here

# Direct Neon Serverless Cloud Database URL (from Neon Console)
# No Neon Local proxy is used in production!
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Arcjet Production Key
ARCJET_KEY=your_production_arcjet_key_here

